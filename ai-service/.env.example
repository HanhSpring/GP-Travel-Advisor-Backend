APP_ENV=development
APP_PORT=8000
MODEL_WEIGHTS_DIR=weights

# NestJS api-service (để ai-service gọi ngược lại nếu cần)
API_SERVICE_URL=http://localhost:3000

# HuggingFace cache
HF_HOME=.cache/huggingface

# Recommender ("Có thể bạn sẽ thích" ở Place Detail)
# Thư mục chứa artifact do Offline_recommender.ipynb sinh ra (recommender_artifacts/)
RECO_ARTIFACT_DIR=recommender_artifacts
# Thư mục chứa file gốc: Places.csv + rating_matrix_foody.npz
RECO_DATA_DIR=data

# Supabase — đọc/ghi cấu hình thuật toán (schema ai_config). Dùng service_role key.
SUPABASE_URL=
SUPABASE_KEY=
AI_CONFIG_SCHEMA=ai_config
