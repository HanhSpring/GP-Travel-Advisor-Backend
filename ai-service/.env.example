APP_ENV=development
APP_PORT=8000

# NestJS api-service
API_SERVICE_URL=http://localhost:3000

# HuggingFace cache
HF_HOME=.cache/huggingface

# Two-Tower model paths (sau khi train xong, copy weights vào thư mục weights/)
TWO_TOWER_VOCAB_PATH=weights/vocab.pkl
TWO_TOWER_WEIGHTS_PATH=weights/best_model.weights.h5

# Goong routing API key for GA travel matrix
GOONG_API_KEY=

# TensorFlow tuning
TF_ENABLE_ONEDNN_OPTS=0
TF_CPP_MIN_LOG_LEVEL=2

# HF-token
HF_TOKEN=<your_huggingface_token>

# Recommender
RECO_ARTIFACT_DIR=recommender_artifacts
RECO_DATA_DIR=data

# Supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=<service_role_key>

AI_CONFIG_SCHEMA=ai_config

# Pipeline output
PIPELINE_OUTPUT_DIR=./output

# Cloudflare R2 artifact bucket
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<r2_access_key_id>
R2_SECRET_ACCESS_KEY=<r2_secret_access_key>
R2_BUCKET_NAME=ai-artifacts
ARTIFACT_CACHE_DIR=/tmp/ai_cache
R2_BASE_TRAINING_PREFIX=base_training_data

# Base rating matrix source for local/Admin retrain: auto | local | r2
# Set to r2 only after upload_base_matrix_to_r2.py completes successfully.
RETRAIN_BASE_RATING_SOURCE=auto
RETRAIN_BASE_RATING_CACHE_DIR=/tmp/retrain_base_rating

# PhoBERT time-label model
# Local fallback path, used when PHOBERT_TIME_MODEL_R2_PREFIX is empty or R2 sync fails.
PHOBERT_TIME_MODEL_PATH=./app/models/phobert_timelabel/checkpoint-60
PHOBERT_TIME_MODEL_R2_PREFIX=phobert_timelabel/checkpoint-60
PHOBERT_TIME_MODEL_CACHE_DIR=/tmp/ai_cache/phobert_timelabel/checkpoint-60
