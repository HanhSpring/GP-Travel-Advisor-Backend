APP_ENV=development
APP_PORT=8000
MODEL_WEIGHTS_DIR=weights

# NestJS api-service (để ai-service gọi ngược lại nếu cần)
API_SERVICE_URL=http://localhost:3000

# HuggingFace cache
HF_HOME=.cache/huggingface

# HF-token
HF_TOKEN=<your_huggingface_token>

# Supabase — lấy từ Project Settings > API trên dashboard Supabase
# Dùng service_role key (không phải anon key) để pipeline có quyền đọc/ghi review_ai.*
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=<service_role_key>

# Thư mục lưu output mỗi lần pipeline chạy
PIPELINE_OUTPUT_DIR=./output

# (Tuỳ chọn) Đường dẫn model PhoBERT fine-tune cho phân loại thời gian
# Bỏ trống nếu chưa có model — pipeline sẽ dùng zero-shot thay thế
# PHOBERT_TIME_MODEL_PATH=./models/phobert_timelabel/checkpoint-60
