# ==============================================
# TRAVEL ADVISOR BACKEND - ENVIRONMENT VARIABLES
# ==============================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file to version control
# ==============================================

# ==============================================
# DATABASE CONFIGURATION
# ==============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=travel_db
DB_USER=admin
DB_PASSWORD=password123

# PostgreSQL Connection String for NestJS (TypeORM/Prisma)
DATABASE_URL=postgresql://admin:password123@localhost:5432/travel_db

# PostgreSQL Connection String for Python (SQLAlchemy)
PYTHON_DATABASE_URL=postgresql://admin:password123@localhost:5432/travel_db

# ==============================================
# API SERVICE (NestJS) CONFIGURATION
# ==============================================
API_SERVICE_PORT=3000
API_SERVICE_HOST=localhost
NODE_ENV=development

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=24h

# API Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ==============================================
# AI SERVICE (Python) CONFIGURATION
# ==============================================
AI_SERVICE_PORT=8000
AI_SERVICE_HOST=0.0.0.0
ENVIRONMENT=development

# AI Service URL (for API Gateway to communicate)
AI_SERVICE_URL=http://localhost:8000

# ==============================================
# EXTERNAL API KEYS (Add as needed)
# ==============================================
# Google Maps API
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# OpenAI API (for AI recommendations)
OPENAI_API_KEY=your-openai-api-key

# Weather API
WEATHER_API_KEY=your-weather-api-key

# ==============================================
# CORS CONFIGURATION
# ==============================================
CORS_ORIGINS=http://localhost:3000,http://localhost:4200

# ==============================================
# LOGGING
# ==============================================
LOG_LEVEL=debug
